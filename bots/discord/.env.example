# Скопируйте в .env (он в .gitignore) и заполните. Токен никому не пересылайте и не коммитьте.

# Discord Developer Portal → ваше приложение → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# ID тестового сервера (Режим разработчика → ПКМ по серверу → Копировать ID)
DISCORD_GUILD_ID=

# Кто управляет записью: ID пользователей через запятую и/или ID роли.
# Если оба пусты — мастером считается участник с правом «Управлять сервером».
MASTER_USER_IDS=
MASTER_ROLE_ID=

# Каталог записей; по умолчанию ~/.rasputye-bots/recordings. Внутри репозитория запрещён.
RECORDINGS_DIR=

# Тишина (мс), после которой фрагмент речи закрывается.
SEGMENT_SILENCE_MS=1000

# Только для проверок на тестовом сервере: ID ботов-«дикторов», которые считаются согласившимися.
TEST_SPEAKER_BOT_IDS=
