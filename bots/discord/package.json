{
  "name": "rasputye-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-бот «Распутья»: запись игровых сессий (PoC, TASK-191)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "register": "node scripts/register-commands.js",
    "export": "node scripts/export-session.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check scripts/register-commands.js && node --check scripts/export-session.js && node --check scripts/doctor.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.0"
  },
  "devDependencies": {
    "prism-media": "1.3.5"
  }
}
